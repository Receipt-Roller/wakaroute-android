<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Only the launch theme lives in XML; everything else is Compose. This exists
      so the window has the right background before the first frame, rather than
      flashing white on a dark-themed phone.
    -->
    <style name="Theme.WakaRoute" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
