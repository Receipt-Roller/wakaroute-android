<?xml version="1.0" encoding="utf-8"?>
<!--
  ワカルート のマーク。iOS で公開しているものと同じです。

  背景は単色で、円とマークは前景に置いています。**元の絵は円が
  キャンバスの 70% を占めていますが、Android の安全領域は 61%
  （108dp のうち 66dp）です。** そのまま全面に敷くと、円形マスクの
  ランチャーでは外側の濃い緑の縁が消え、角丸マスクでは残る — 端末に
  よって別の絵になります。前景を 61% に収めることで、どのマスク形状でも
  同じに見えます。

  monochrome は Android 13 以降のテーマアイコン用です。マークだけの
  シルエットで、色はシステムが付けます。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
