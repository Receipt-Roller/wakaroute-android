<?xml version="1.0" encoding="utf-8"?>
<!--
  The pre-Android-12 half of the same decision as data_extraction_rules.xml.
  Nothing is backed up.

  `allowBackup="false"` already covers these versions on its own. The rules are
  declared anyway so that turning backup on later — for a legitimate reason
  nobody has thought of yet — cannot quietly start copying credentials off the
  device as a side effect.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
