# Copy to `keystore.properties` and fill in. **That file is gitignored — keep it
# that way.** This repository is public, and a key or password committed once
# cannot be taken back by deleting it in a later commit.
#
# Create the upload key with (it will prompt for the passwords — do not put them
# on the command line, where they land in your shell history):
#
#   keytool -genkeypair -v -keystore wakaroute-upload.jks \
#     -alias wakaroute -keyalg RSA -keysize 4096 -validity 10000
#
# Then back up the .jks and its passwords somewhere that survives this laptop.
# Play signs releases with its own key, so a lost *upload* key can be reset with
# Google — but only by someone who can prove they own the account, and not
# quickly.

# Relative to the repository root.
storeFile=wakaroute-upload.jks
storePassword=
keyAlias=wakaroute
keyPassword=
